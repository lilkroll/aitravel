# Copy this file to .env (same folder) and fill in your keys there — never in this file.
# .env is gitignored and copied into the app bundle at build time.
# Values set in the Xcode scheme's environment variables override this file.

# Jev by TypeSafe AI — matches the traveller's wish to places.
# Set ONE of these: a TypeSafe key (https://api.typesafe.ai) or an OpenRouter key
# (https://openrouter.ai, served at /api/alpha/decisions). JEV_API_KEY wins if both are set.
JEV_API_KEY=
OPENROUTER_API_KEY=
# "jev-latest" or a pinned version like "jev-1.13"; mapped to "~typesafe/jev-latest" / "typesafe/jev-1.13" on OpenRouter.
JEV_MODEL=jev-latest

# MiniMax — writes custom trip plans when no ready-made route fits (https://platform.minimax.io)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash-Preview
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
